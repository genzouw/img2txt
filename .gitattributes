# セキュリティ：意図せずコミットされた場合の diff 露出を防ぐため、秘匿性の高いファイルは -diff を指定
*.env* -diff
*.env.example diff
*.env.sample diff
*.env.template diff
*.pem -diff
*.key -diff
credentials.json -diff
*.tfvars -diff
*.tfvars.json -diff
*id_rsa -diff
*id_ed25519 -diff
*id_dsa -diff
*id_ecdsa -diff
*.p12 -diff
*.jks -diff
*.keystore -diff
*.kdbx -diff
*htpasswd -diff
application_default_credentials.json -diff
.npmrc -diff
.netrc -diff
**/.aws/credentials -diff
**/.aws/config -diff
**/.docker/config.json -diff
**/.kube/config -diff
.git-credentials -diff

# セキュリティ：AI エージェントの作業跡や内部情報がリリースアーカイブに含まれないようにする
.cursor/ export-ignore
.claude/ export-ignore
.aider* export-ignore
.gemini/ export-ignore
.gemini/* -diff
.gemini/config.yaml diff
.github/ export-ignore

# セキュリティ：DBファイルやログファイルのローカルデータ漏洩防止
*.log -diff
*.sqlite -diff
*.sqlite-journal -diff
*.sqlite-wal -diff
*.sqlite-shm -diff
*.sqlite3 -diff
*.sqlite3-journal -diff
*.sqlite3-wal -diff
*.sqlite3-shm -diff
*.db -diff
*.db-journal -diff
*.db-wal -diff
*.db-shm -diff
*.dump -diff
*.sql -diff

# セキュリティ：ローカル履歴や上書きファイルの漏洩防止
.*_history -diff
docker-compose.override.yml -diff
docker-compose.override.yaml -diff

# セキュリティ：ネットワーク設定・パケットキャプチャの漏洩防止
*.ovpn -diff
*.pcap -diff
*.pcapng -diff

# セキュリティ：macOSキーチェーンの漏洩防止
*.keychain -diff
*.keychain-db -diff
